          var(--paper);
        color: var(--paper-ink);
        border-radius: 3px 3px 6px 6px;
        box-shadow:
          0 3px 0 #e8e0cf,
          0 6px 0 #d9cfba,
          0 18px 34px #0008;
      }
      .pad::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 22px;
        border-radius: 3px 3px 0 0;
        background:
          radial-gradient(circle at 50% 55%, #2c1c12 0 4px, #0000 4.5px) 8px 0 / 28px 22px repeat-x,
          linear-gradient(180deg, #8f1d1d, #6d1515);
      }
      .pad::after {
        content: '';
        position: absolute;
        top: 22px;
        bottom: 0;
        left: clamp(44px, 5.5vw, 60px);
        width: 2px;
        background: #e8a3a3;
      }
      .pad h2,
      .icard h2 {
        font:
          700 40px/1 Caveat,
          cursive;
        color: var(--pen);
      }
      .times {
        list-style: none;
        padding: 0;
        margin: 16px 0 0;
      }
      .times li {
        display: grid;
        grid-template-columns: 3.4em minmax(0, 1fr);
        gap: 14px;
        padding: 12px 0;
        border-top: 1px solid var(--rule);
      }
      .t {
        font:
          700 30px/1 Caveat,
          cursive;
        color: var(--pen);
        white-space: nowrap;
      }
      .times h3 {
        margin: 0;
        font-size: 17px;
        line-height: 1.3;
      }
      .times h3 .s {
        margin-right: 6px;
      }
      .times h3 .s.red {
        color: #c8102e;
      }
      .times h3 .s.joker {
        color: var(--pen);
      }
      .times p {
        margin: 3px 0 0;
        color: var(--paper-mute);
      }
      .icard {
        grid-area: card;
        position: relative;
        padding: 18px 22px 22px;
        background:
          var(--noise-soft),
          linear-gradient(#0000 52px, #e58c8c 52px 54px, #0000 54px),
          repeating-linear-gradient(#0000 0 29px, #c9d8ec 29px 30px) 0 54px / 100% calc(100% - 54px) no-repeat,
          #fffefa;
        color: var(--paper-ink);
        border-radius: 4px;
        box-shadow:
          0 14px 28px #0008,
          0 1px 0 #0003;
      }
      @media (min-width: 901px) {
        .icard {
          position: sticky;
          top: 16px;
          transform: rotate(0.7deg);
        }
      }
      .icard h2 {
        line-height: 34px;
      }
      label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        margin: 16px 0 6px;
      }
      input[type='time'] {
        width: 100%;
        font: 16px Inter, sans-serif;
        min-height: 46px;
        padding: 8px 12px;
        border: 1px solid #b9ad97;
        border-radius: 8px;
        background: #fff;
        color: var(--paper-ink);
        box-shadow: inset 0 2px 3px #0002;
      }
      input[type='time']:focus-visible {
        outline: 3px solid var(--go);
        outline-offset: 1px;
      }
      .seg {
        display: flex;
        gap: 8px;
      }
      .seg button {
        flex: 1;
        font: 600 15px Inter, sans-serif;
        color: var(--paper-ink);
        background: linear-gradient(180deg, #fbf6ea, #e9dfc9);
        border: 1px solid #c9bb9d;
        border-radius: 10px;
        min-height: 44px;
        cursor: pointer;
        box-shadow: 0 3px 0 #c2b292;
      }
      .seg button[aria-pressed='true'] {
        background: linear-gradient(180deg, #2a4bc4, var(--go));
        border-color: var(--go-edge);
        color: #fff;
        transform: translateY(2px);
        box-shadow:
          0 1px 0 var(--go-edge),
          inset 0 2px 3px #0005;
      }
      .seg button:focus-visible {
        outline: 3px solid var(--go);
        outline-offset: 2px;
      }
      .go {
        display: block;
        width: 100%;
        margin-top: 22px;
        min-height: 60px;
        background: linear-gradient(180deg, #2f52cc, var(--go));
        color: #fff;
        border: 0;
        border-radius: 14px;
        font:
          800 27px/1 'Big Shoulders Display',
          sans-serif;
        cursor: pointer;
        text-shadow: 0 1px 0 #0006;
        box-shadow:
          0 6px 0 var(--go-edge),
          0 12px 18px #0005;
      }
      .go:active {
        transform: translateY(4px);
        box-shadow:
          0 2px 0 var(--go-edge),
          0 4px 8px #0005;
      }
      .go:focus-visible,
      .btn:focus-visible {
        outline: 3px solid var(--go);
        outline-offset: 4px;
      }

      .how {
        margin: 10px 0 0;
        min-height: 3em;
        color: var(--pen);
        font:
          600 21px/1.15 Caveat,
          cursive;
      }
      .seg button {
        padding-inline: 4px;
      }

      /* ---- run mode: the card on the felt ---- */
      .run {
        position: fixed;
        inset: 0;
        z-index: 20;
        display: none;
        flex-direction: column;
        overflow: auto;
        color: #fff;
        background:
          var(--noise),
          radial-gradient(120% 90% at 50% 0%, var(--felt), var(--felt-deep));
      }
      .run.on {
        display: flex;
      }
      .rtop {
        padding: 16px max(4vw, 16px);
        background:
          var(--noise),
          linear-gradient(180deg, #4a2b1c, var(--leather));
        box-shadow:
          0 6px 16px #0007,
          inset 0 -2px 0 #0006;
      }
      .rwrap {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: end;
        gap: 8px 20px;
        max-width: 900px;
        margin: 0 auto;
      }
      .rtop h2 {
        font:
          800 clamp(34px, 6vw, 48px) / 1.05 'Big Shoulders Display',
          sans-serif;
        color: var(--cream);
      }
      .rtop p {
        margin: 2px 0 0;
        color: var(--cream-mute);
      }
      .clock {
        text-align: right;
        font:
          800 clamp(40px, 8vw, 64px) / 1 'Big Shoulders Display',
          sans-serif;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        color: var(--cream);
      }
      .clock small {
        display: block;
        font:
          500 14px/1.4 Inter,
          sans-serif;
        color: var(--cream-mute);
      }
      .rbody {
        flex: 1;
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        padding: 24px max(4vw, 16px) 28px;
      }
      .solo {
        width: min(360px, 100%);
      }
      .list {
        margin: 0;
        padding: 18px 20px 18px 2.4em;
        font-size: 18px;
        max-width: 560px;
        background:
          var(--noise-soft),
          var(--paper);
        color: var(--paper-ink);
        border-radius: 3px;
        box-shadow: 0 10px 22px #0007;
        transform: rotate(-0.5deg);
      }
      .list li {
        margin: 6px 0;
      }
      .rbtns {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 26px;
      }
      .btn {
        min-height: 50px;
        padding: 0 20px;
        border-radius: 12px;
        border: 0;
        background: linear-gradient(180deg, #fffaf0, #eadfc6);
        color: var(--paper-ink);
        font: 600 16px Inter, sans-serif;
        cursor: pointer;
        box-shadow:
          0 4px 0 #b8a57f,
          0 8px 14px #0005;
      }
      .btn:active:not(:disabled) {
        transform: translateY(3px);
        box-shadow:
          0 1px 0 #b8a57f,
          0 3px 6px #0005;
      }
      .btn.main {
        background: linear-gradient(180deg, #2f52cc, var(--go));
        color: #fff;
        font:
          800 24px/1 'Big Shoulders Display',
          sans-serif;
        padding: 0 28px;
        flex: 1 1 220px;
        box-shadow:
          0 5px 0 var(--go-edge),
          0 10px 16px #0005;
      }
      .btn.main:active {
        box-shadow:
          0 2px 0 var(--go-edge),
          0 4px 8px #0005;
      }
      .btn:disabled {
        opacity: 0.5;
        cursor: default;
      }
      @media (prefers-reduced-motion: reduce) {
        * {
          transition: none !important;
        }
      }
    </style>
  </body>
</html>
