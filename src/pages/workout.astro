---
import { DECKS } from '../workout/decks'

// Fonts that decks ask for in their art.
const deckFonts = [...new Set(DECKS.map((d) => d.art.lettering.href).filter(Boolean))] as string[]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>Workout Decks</title>
    <meta
      name="description"
      content="Pick one or more exercise decks, deal a five-card workout, and run it on a timer."
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href="/favicon.svg?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32.png?v=2"
    />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {
      deckFonts.map((href) => (
        <link
          href={href}
          rel="stylesheet"
        />
      ))
    }
  </head>
  <body>
    <header class="wrap top">
      <p class="crumb"><a href="/">← Byte Garden</a></p>
      <h1>Workout decks</h1>
    </header>

    <section
      class="wrap pick"
      aria-labelledby="h-decks"
    >
      <div class="pick-grid">
        <div>
          <h2 id="h-decks">Decks</h2>
          <div
            class="shelf"
            id="decks"
          >
          </div>
        </div>
        <aside
          class="slip"
          id="slip"
          aria-labelledby="h-mix"
          hidden
        >
          <h2 id="h-mix">Mix</h2>
          <div id="mix"></div>
        </aside>
      </div>
    </section>

    <section
      class="wrap"
      aria-labelledby="h-hand"
    >
      <div class="rail">
        <div class="felt">
          <h2
            class="vh"
            id="h-hand"
          >
            Your hand
          </h2>
          <div
            class="hand"
            id="hand"
          >
            <div class="slot">
              <button
                class="pile"
                id="deck"
                aria-label="Shuffle and deal a new hand. Tap any card to redraw just that card."
              ></button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap lower">
      <div class="pad">
        <h2>Today's schedule</h2>
        <ol class="times" id="times"></ol>
      </div>
      <aside class="icard">
        <label id="typeLab">Type</label>
        <div class="seg" id="type" role="group" aria-labelledby="typeLab"><button data-v="circuit">Circuit</button><button data-v="sets">Sets</button><button data-v="variety">Variety</button></div>
        <p class="how" id="how" aria-live="polite"></p>
        <label id="lenLab">Length</label>
        <div class="seg" id="len" role="group" aria-labelledby="lenLab"><button data-v="20">20 min</button><button data-v="30">30 min</button><button data-v="45">45 min</button></div>
        <label for="start">Time</label>
        <input type="time" id="start" />
        <button class="go" id="go">Start</button>
      </aside>
    </section>

    <div class="run" id="run" role="dialog" aria-modal="true" aria-labelledby="rb">
      <div class="rtop"><div class="rwrap"><div><h2 id="rb">Warm-up</h2><p id="rs"></p></div><div class="clock" id="rclock">0:00<small id="rleft"></small></div></div></div>
      <div class="rbody">
        <div id="rmain"></div>
        <div class="rbtns"><button class="btn main" id="rnext">Next</button><button class="btn" id="rback">Back</button><button class="btn" id="rend">End</button></div>
      </div>
    </div>

    <script>
      import { DECKS } from '../workout/decks'
      import type { Deck, Suit } from '../workout/types'
      import { dealHand, redrawFrom, uniqueCards, type Dealt } from '../workout/deal'
      import { buildPlan, cardCount, LENGTHS, TYPES, type Plan, type Step, type WorkoutType } from '../workout/plan'

      const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T
      const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch] as string)

      const SUIT: Record<Suit, [string, string]> = { legs: ['♠', ''], push: ['♥', 'red'], pull: ['♦', 'red'], hinge: ['♣', ''], core: ['★', 'joker'] }
      const KEY = 'workoutdecks.v1'

      /** A deck's art as CSS custom properties, for its box, card backs and card faces. */
      const art = (d: Deck) => {
        const a = d.art
        return esc(`--back:${a.back.background};--back-border:${a.back.border};--box:${a.box.color};--box-ink:${a.box.ink};--box-label:${a.box.label};--letter:${a.lettering.font};--letter-scale:${a.lettering.scale ?? 1};--face:${a.face.background};--face-text:${a.face.text};--face-muted:${a.face.muted};--face-line:${a.face.line};--face-accent:${a.face.accent};--red:${a.suits.red};--black:${a.suits.black};--star:${a.suits.star}`)
      }

      interface State {
        start: string
        len: number
        type: WorkoutType
        decks: Record<string, number>
        hand: [string, string][] | null
      }
      let st: State = { start: '06:30', len: 30, type: 'circuit', decks: { [DECKS[0].id]: 100 }, hand: null }
      try {
        const s = JSON.parse(localStorage.getItem(KEY) || 'null')
        if (s) st = { start: s.start || st.start, len: s.len || st.len, type: s.type || st.type, decks: s.decks || st.decks, hand: s.hand || null }
      } catch (e) {}
      const deckById = (id: string) => DECKS.find((d) => d.id === id)
      for (const id of Object.keys(st.decks)) if (!deckById(id)) delete st.decks[id]
      if (!Object.keys(st.decks).length) st.decks = { [DECKS[0].id]: 100 }
      if (!LENGTHS[st.len]) st.len = 30
      if (!TYPES.some((t) => t.id === st.type)) st.type = 'circuit'
      const save = () => {
        try {
          localStorage.setItem(KEY, JSON.stringify(st))
        } catch (e) {}
      }
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

      const picked = () => DECKS.filter((d) => d.id in st.decks)
      const mix = () => picked().map((deck) => ({ deck, weight: st.decks[deck.id] }))

      // ---- the hand: 5 cards for Circuit and Sets, as many as fit the time for Variety ----
      const load = (): Dealt[] =>
        (st.hand || []).flatMap(([d, c]) => {
          const deck = deckById(d)
          const card = deck?.cards.find((x) => x.id === c)
          return deck && card && d in st.decks ? [{ deck, card }] : []
        })
      /**
       * Deal (or top up / trim) the hand to the number of cards this type and length call for.
       * Cards already on the table stay put unless `fresh` starts over.
       */
      function setHand(fresh: boolean) {
        const n = cardCount(st.type, st.len, uniqueCards(mix()))
        const h = dealHand(mix(), n, Math.random, fresh ? [] : load().slice(0, n))
        st.hand = h.map((x) => [x.deck.id, x.card.id])
        save()
      }
      function hand(): Dealt[] {
        if (!load().length) setHand(false)
        return load()
      }
      const plan = (): Plan =>
        buildPlan(
          st.type,
          st.len,
          hand().map((x) => x.card)
        )

      // ---- deck shelf and mix ----
      function renderDecks() {
        $('#decks').innerHTML =
          DECKS.map((d) => {
            const on = d.id in st.decks
            return `<button class="tuck" data-id="${d.id}" aria-pressed="${on}" aria-label="${esc(d.name)} deck" style="${art(d)}" title="${esc(d.blurb)} ${esc(d.gear)}.">
              <span class="box" aria-hidden="true">
                <span class="lid"></span>
                <span class="peek"><i></i><i></i></span>
                <span class="side"></span>
                <span class="bface"><span class="art"></span><span class="plate"><b>${esc(d.name)}</b></span><span class="suits">♠ ♥ ♦ ♣ ★</span></span>
                <span class="seal"></span>
              </span>
            </button>`
          }).join('')
        fitNames()
      }
      /** Shrink each deck name until it fits on its box label, whatever the deck's lettering. */
      function fitNames() {
        document.querySelectorAll<HTMLElement>('.plate b').forEach((b) => {
          b.style.fontSize = ''
          const room = (b.parentElement as HTMLElement).clientWidth * 0.9
          if (b.scrollWidth > room) b.style.fontSize = `${parseFloat(getComputedStyle(b).fontSize) * (room / b.scrollWidth)}px`
        })
      }
      document.fonts?.ready.then(fitNames)
      new ResizeObserver(fitNames).observe($('#decks'))
      /** Keep the picked decks' weights adding up to 100. `keep` holds its value; the rest share what's left in proportion. */
      function balance(keep?: string) {
        const ids = picked().map((d) => d.id)
        const fixed = keep && ids.includes(keep) ? Math.min(100, Math.max(0, st.decks[keep])) : 0
        const others = ids.filter((id) => id !== keep)
        const sum = others.reduce((s, id) => s + Math.max(0, st.decks[id] || 0), 0)
        const room = 100 - fixed
        let given = 0
        others.forEach((id, i) => {
          const share = i === others.length - 1 ? room - given : Math.round(sum ? (Math.max(0, st.decks[id] || 0) / sum) * room : room / others.length)
          st.decks[id] = share
          given += share
        })
        if (keep && ids.includes(keep)) st.decks[keep] = fixed
      }
      function mixLabel(m: { weight: number }[], i: number) {
        const total = m.reduce((s, x) => s + x.weight, 0)
        return `${total ? Math.round((m[i].weight / total) * 100) : i === 0 ? 100 : 0}%`
      }
      function renderMix() {
        const m = mix()
        $('#slip').hidden = m.length < 2
        $('.pick-grid').classList.toggle('one-deck', m.length < 2)
        if (m.length < 2) {
          $('#mix').innerHTML = ''
          return
        }
        $('#mix').innerHTML = m
          .map(
            (x, i) =>
              `<div class="mx" style="${art(x.deck)}"><label for="mx-${x.deck.id}"><span>${esc(x.deck.name)}</span><output>${mixLabel(m, i)}</output></label><input type="range" id="mx-${x.deck.id}" data-id="${x.deck.id}" min="0" max="100" step="1" value="${x.weight}"></div>`
          )
          .join('')
      }
      function renderPile() {
        const p = picked()
        const layers = [0, 1, 2].map((i) => p[i % p.length])
        $('#deck').innerHTML =
          layers
            .reverse()
            .map((d, i) => `<span class="stock back l${2 - i}" style="${art(d)}"></span>`)
            .join('') + `<span class="lab">Shuffle</span>`
      }
      $('#decks').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.tuck')
        if (!b) return
        const id = b.dataset.id as string
        if (id in st.decks) {
          if (picked().length === 1) {
            b.animate?.([{ transform: 'translateX(0)' }, { transform: 'translateX(-5px)' }, { transform: 'translateX(5px)' }, { transform: 'translateX(0)' }], { duration: 260 })
            return
          }
          delete st.decks[id]
          balance()
        } else {
          st.decks[id] = Math.round(100 / (picked().length + 1))
          balance(id)
        }
        renderDecks()
        renderMix()
        setHand(true)
        deal(true)
      })
      $('#mix').addEventListener('input', (e) => {
        const r = e.target as HTMLInputElement
        if (!r.dataset.id) return
        st.decks[r.dataset.id] = Number(r.value)
        balance(r.dataset.id)
        const m = mix()
        document.querySelectorAll<HTMLInputElement>('#mix input').forEach((x, i) => {
          if (x !== r) x.value = String(m[i].weight)
        })
        document.querySelectorAll<HTMLOutputElement>('#mix output').forEach((o, i) => (o.textContent = mixLabel(m, i)))
      })
      $('#mix').addEventListener('change', (e) => {
        if (!(e.target as HTMLInputElement).dataset.id) return
        setHand(true)
        deal(true)
      })

      // ---- cards ----
      function face(x: Dealt, label: number | string) {
        const [sym, cls] = SUIT[x.card.suit]
        const c = x.card
        const corner = (pos: string) => `<span class="corner ${pos}" aria-hidden="true"><b>${label}</b><i>${sym}</i></span>`
        return `<div class="face stock front ${cls}" style="${art(x.deck)}">${corner('tl')}${corner('br')}<span class="pip" aria-hidden="true">${sym}</span><div class="fbody"><h3>${esc(c.name)}</h3><p class="reps">${esc(c.reps)}</p><p class="cue">${esc(c.cue)}</p><p class="alt"><span><span class="vh">Easier: </span><i aria-hidden="true">−</i>${esc(c.easier)}</span><span><span class="vh">Harder: </span><i aria-hidden="true">+</i>${esc(c.harder)}</span></p></div></div>`
      }
      /**
       * Shrink a card's text a little when its content won't fit the card. Sizes are relative to
       * the card's width, so a card fits the same way at every size.
       */
      function fit(root: ParentNode) {
        root.querySelectorAll<HTMLElement>('.front').forEach((f) => {
          let k = 1
          f.style.setProperty('--fit', '1')
          while (f.scrollHeight > f.clientHeight + 1 && k > 0.6) {
            k -= 0.04
            f.style.setProperty('--fit', String(k))
          }
        })
      }
      document.fonts?.ready.then(() => fit(document))

      let cards: HTMLElement[] = []
      /** Make one slot per card in the hand (the pile is always the first slot). */
      function slots(n: number) {
        const box = $('#hand')
        while (box.children.length - 1 < n) {
          const s = document.createElement('div')
          s.className = 'slot'
          s.innerHTML = '<div class="card pending" role="button" tabindex="0"></div>'
          const i = box.children.length - 1
          const c = s.firstElementChild as HTMLElement
          c.addEventListener('click', () => redraw(i))
          c.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault()
              redraw(i)
            }
          })
          box.appendChild(s)
        }
        while (box.children.length - 1 > n) box.lastElementChild?.remove()
        cards = [...box.querySelectorAll<HTMLElement>('.card')]
      }
      function fill(i: number, x: Dealt) {
        cards[i].innerHTML = face(x, i + 1) + `<div class="face stock back" style="${art(x.deck)}"></div>`
        cards[i].setAttribute('aria-label', `Card ${i + 1}, ${x.card.name}, ${x.card.reps}. ${x.card.cue} Tap to redraw.`)
        fit(cards[i])
      }

      // ---- schedule ----
      const toMin = (t: string) => {
        const [h, m] = (t || '06:30').split(':').map(Number)
        return h * 60 + m
      }
      const fmt = (secs: number) => {
        const m = Math.round(secs / 60 + 1440) % 1440
        const h = Math.floor(m / 60) % 12 || 12
        return `${h}:${String(m % 60).padStart(2, '0')}`
      }
      function schedule() {
        const p = plan()
        const h = hand()
        const n = h.length
        let t = toMin(st.start) * 60
        const rows: [number, string, string][] = []
        const head = (x: Dealt) => `<span class="s ${SUIT[x.card.suit][1]}">${SUIT[x.card.suit][0]}</span>${esc(x.card.name)}`
        let workIndex = 0
        p.steps.forEach((s) => {
          if (s.kind === 'warm') rows.push([t, 'Warm-up', `${s.secs / 60} min`])
          if (s.kind === 'cool') rows.push([t, 'Cool-down', `${s.secs / 60} min`])
          if (s.kind === 'work') {
            const x = h[s.card]
            if (st.type === 'circuit' && s.card === 0) rows.push([t, `Lap ${Math.floor(workIndex / n) + 1}`, `All ${n} cards, one set each`])
            if (st.type === 'sets' && workIndex % p.repeat === 0) rows.push([t, head(x), `${p.repeat} sets of ${esc(x.card.reps)}`])
            if (st.type === 'variety') rows.push([t, head(x), esc(x.card.reps)])
            workIndex++
          }
          t += s.secs
        })
        rows.push([t, 'Done', ''])
        $('#times').innerHTML = rows.map(([at, h, p]) => `<li><span class="t">${fmt(at)}</span><div><h3>${h}</h3>${p ? `<p>${p}</p>` : ''}</div></li>`).join('')
        $('#how').textContent = p.summary
        document.querySelectorAll<HTMLButtonElement>('#len button').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.v) === st.len)))
        document.querySelectorAll<HTMLButtonElement>('#type button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === st.type)))
        renderPile()
        return p
      }

      function deal(animate: boolean) {
        const h = hand()
        slots(h.length)
        schedule()
        h.forEach((x, i) => fill(i, x))
        cards.forEach((el) => el.classList.remove('pending'))
        if (!animate || reduce || !cards[0]?.animate) return
        const deck = $('#deck'),
          dr = deck.getBoundingClientRect()
        const stagger = Math.min(170, 1100 / cards.length)
        deck.animate([{ transform: 'rotate(0)' }, { transform: 'rotate(-4deg) translateY(-4px)' }, { transform: 'rotate(3deg)' }, { transform: 'rotate(0)' }], { duration: 380, easing: 'ease-in-out' })
        cards.forEach((el, i) => {
          const r = el.getBoundingClientRect()
          const dx = dr.left + dr.width / 2 - (r.left + r.width / 2),
            dy = dr.top + dr.height / 2 - (r.top + r.height / 2)
          el.animate([{ transform: `translate(${dx}px,${dy}px) rotateY(180deg) rotate(-6deg)` }, { transform: `translate(${dx * 0.35}px,${dy * 0.35 - 36}px) rotateY(150deg) rotate(4deg)`, offset: 0.5 }, { transform: 'none' }], { duration: 720, delay: 380 + i * stagger, easing: 'cubic-bezier(.2,.75,.25,1)', fill: 'backwards' })
        })
      }
      function redraw(i: number) {
        const h = hand()
        const cur = h[i]
        if (!cur) return
        const card = redrawFrom(cur.deck, cur.card, h)
        const x = { deck: cur.deck, card }
        ;(st.hand as [string, string][])[i] = [cur.deck.id, card.id]
        save()
        const el = cards[i]
        const update = () => {
          schedule()
          fill(i, x)
        }
        if (reduce || !el.animate) return update()
        el.animate([{ transform: 'none' }, { transform: 'rotateY(90deg)' }], { duration: 170, easing: 'ease-in' }).finished.then(() => {
          update()
          el.animate([{ transform: 'rotateY(-90deg)' }, { transform: 'none' }], { duration: 240, easing: 'ease-out' })
        })
      }
      $('#deck').addEventListener('click', () => {
        setHand(true)
        deal(true)
      })
      $('#len').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button')
        if (!b) return
        st.len = Number(b.dataset.v)
        setHand(false)
        deal(false)
      })
      $('#type').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button')
        if (!b || b.dataset.v === st.type) return
        const before = hand().length
        st.type = b.dataset.v as WorkoutType
        setHand(false)
        deal(hand().length > before)
      })
      const startIn = $<HTMLInputElement>('#start')
      startIn.value = st.start
      startIn.addEventListener('input', () => {
        if (startIn.value) {
          st.start = startIn.value
          save()
          schedule()
        }
      })

      // ---- run mode: one step at a time. Tap Done after each set (and rest as long as you need). ----
      let run: { steps: Step[]; i: number; t0: number; ts: number; end?: boolean; h: Dealt[]; p: Plan } | null = null
      let tick: number | undefined
      let lock: WakeLockSentinel | null = null
      const mmss = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`
      const rclock = () => $('#rclock').firstChild as Text
      function show() {
        if (!run) return
        const s = run.steps[run.i]
        const nx = run.steps[run.i + 1]
        run.ts = Date.now()
        let title = '',
          sub = '',
          html = ''
        if (s.kind === 'warm') {
          title = 'Warm-up'
          html = '<ol class="list"><li>2 min marching or jumping jacks</li><li>10 squats</li><li>5 push-ups</li><li>10 glute bridges</li><li>20 arm circles each way</li></ol>'
        }
        if (s.kind === 'cool') {
          title = 'Cool-down'
          html = "<ol class=\"list\"><li>Hamstring stretch, 30 sec each side</li><li>Hip flexor stretch, 30 sec each side</li><li>Child's pose, 30 sec</li></ol>"
        }
        if (s.kind === 'work') {
          const x = run.h[s.card]
          title = x.card.name
          sub = s.label
          html = `<div class="solo"><div class="card static">${face(x, s.card + 1)}</div></div>`
        }
        $('#rb').textContent = title
        $('#rs').textContent = sub
        $('#rmain').innerHTML = html
        fit($('#rmain'))
        $('#rnext').textContent = !nx ? 'Finish' : s.kind === 'work' ? 'Done' : 'Next'
        $<HTMLButtonElement>('#rback').disabled = run.i === 0
        clock()
      }
      function advance() {
        if (!run || run.end) return
        if (run.i === run.steps.length - 1) finish()
        else {
          run.i++
          show()
        }
      }
      function clock() {
        if (!run || run.end) return
        const s = run.steps[run.i]
        const t = (Date.now() - run.ts) / 1000
        if (s.kind === 'work') rclock().textContent = mmss(t)
        else {
          const left = s.secs - t
          rclock().textContent = left >= 0 ? mmss(Math.ceil(left)) : `+${mmss(-left)}`
        }
        $('#rleft').textContent = `${mmss((Date.now() - run.t0) / 1000)} of ~${run.p.minutes}:00`
      }
      function finish() {
        if (!run) return
        run.end = true
        clearInterval(tick)
        $('#rb').textContent = 'Done.'
        $('#rs').textContent = 'Nice work, both of you.'
        rclock().textContent = mmss((Date.now() - run.t0) / 1000)
        $('#rleft').textContent = 'total'
        $('#rmain').innerHTML = '<ol class="list">' + run.h.map((x) => `<li>${esc(x.card.name)}</li>`).join('') + '</ol>'
        $('#rnext').style.display = 'none'
        $<HTMLButtonElement>('#rback').disabled = true
        $('#rend').textContent = 'Close'
      }
      $('#go').addEventListener('click', async () => {
        const p = plan()
        run = { steps: p.steps, i: 0, t0: Date.now(), ts: Date.now(), h: hand(), p }
        $('#rnext').style.display = ''
        $('#rend').textContent = 'End'
        $('#run').classList.add('on')
        document.body.style.overflow = 'hidden'
        show()
        tick = window.setInterval(clock, 250)
        $('#rnext').focus()
        try {
          lock = await navigator.wakeLock.request('screen')
        } catch (e) {
          lock = null
        }
      })
      $('#rnext').addEventListener('click', advance)
      $('#rback').addEventListener('click', () => {
        if (run && !run.end && run.i > 0) {
          run.i--
          show()
        }
      })
      $('#rend').addEventListener('click', () => {
        clearInterval(tick)
        run = null
        $('#run').classList.remove('on')
        document.body.style.overflow = ''
        if (lock) {
          lock.release().catch(() => {})
          lock = null
        }
      })
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && run) $('#rend').click()
      })

      balance()
      renderDecks()
      renderMix()
      setHand(false)
      requestAnimationFrame(() => deal(true))
    </script>

    <style is:global>
