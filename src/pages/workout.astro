---
import { DECKS } from '../workout/decks'

// Fonts that decks ask for in their art.
const deckFonts = [...new Set(DECKS.map((d) => d.art.lettering.href).filter(Boolean))] as string[]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <title>Workout Decks</title>
    <meta
      name="description"
      content="Pick one or more exercise decks, deal a five-card workout, and run it on a timer."
    />
    <link
      rel="icon"
      type="image/svg+xml"
      sizes="any"
      href="/favicon.svg?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32.png?v=2"
    />
    <link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800&family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {
      deckFonts.map((href) => (
        <link
          href={href}
          rel="stylesheet"
        />
      ))
    }
  </head>
  <body>
    <header class="top">
      <div class="topbar">
        <a
          class="home"
          href="/"
          aria-label="Byte Garden home">←</a
        >
        <span class="brand">Workout decks</span>
        <div class="workout-clock">
          <span id="rtotal-label">Total time</span>
          <div id="rtotal" role="timer" aria-labelledby="rtotal-label">0:00</div>
        </div>
      </div>
      <nav
        class="steps"
        aria-label="Steps"
      >
        <ol>
          <li><a href="#workout" data-step="workout"><span class="n">1</span><span class="lbl">Workout</span></a></li>
          <li><a href="#decks" data-step="decks"><span class="n">2</span><span class="lbl">Decks</span></a></li>
          <li><a href="#cards" data-step="cards"><span class="n">3</span><span class="lbl">Cards</span></a></li>
          <li><a href="#start" data-step="start"><span class="n">4</span><span class="lbl">Start</span></a></li>
        </ol>
      </nav>
    </header>

    <main>
      <section
        class="screen narrow"
        id="s-workout"
        data-step="workout"
        aria-labelledby="h-work"
      >
        <h1 id="h-work">Pick a workout</h1>
        <div
          class="types"
          id="type"
          role="radiogroup"
          aria-label="Workout type"
        >
          <button role="radio" data-v="circuit"><b>Circuit</b><span data-how="circuit"></span></button>
          <button role="radio" data-v="sets"><b>Sets</b><span data-how="sets"></span></button>
          <button role="radio" data-v="variety"><b>Variety</b><span data-how="variety"></span></button>
        </div>
        <h2
          class="sub-h"
          id="lenLab"
        >
          How long?
        </h2>
        <div class="seg" id="len" role="group" aria-labelledby="lenLab"><button data-v="20">20 min</button><button data-v="30">30 min</button><button data-v="45">45 min</button></div>
      </section>

      <section
        class="screen narrow"
        id="s-decks"
        data-step="decks"
        aria-labelledby="h-decks"
        hidden
      >
        <h1 id="h-decks">Open your decks</h1>
        <p class="hint">Pick one or more.</p>
        <div
          class="shelf"
          id="decks"
        >
        </div>
      </section>

      <section
        class="screen wide"
        id="s-cards"
        data-step="cards"
        aria-label="Cards"
        hidden
      >
        <p class="hint" id="hint"></p>
        <div class="hand" id="hand">
          <div class="slot">
            <button
              class="pile"
              id="deck"
              aria-label="Deal a new exercise hand."
            ></button>
          </div>
        </div>
        <p
          class="vh"
          id="fanpos"
          aria-live="polite"
        >
        </p>
      </section>

      <section
        class="screen narrow"
        id="s-start"
        data-step="start"
        aria-labelledby="h-schedule"
        hidden
      >
        <div class="pad">
          <div class="pad-sheet">
            <h2 id="h-schedule">Today's schedule</h2>
            <ol class="times" id="times"></ol>
          </div>
        </div>
      </section>
    </main>

    <div class="navbar">
      <div class="navin">
        <button class="btn back-button" id="back">Back</button>
        <button class="go" id="next">Next</button>
      </div>
    </div>

    <div class="inspect" id="inspect" role="dialog" aria-modal="true" aria-label="Card" hidden>
      <div class="ibox">
        <div class="iwrap"><div class="card static" id="icard"></div></div>
        <div class="ibtns"><button class="btn" id="iswap">Swap</button><button class="btn main" id="ikeep">Keep</button></div>
      </div>
    </div>

    <section class="run" id="run" role="main" aria-labelledby="rb">
      <div class="rtop">
        <div class="rwrap">
          <h2 class="vh" id="rb">Warm-up</h2>
          <div class="workout-progress">
            <progress id="rprogress" value="0" aria-label="Workout progress"></progress>
          </div>
        </div>
      </div>
      <div class="rbody" id="rbody">
        <div id="rmain"></div>
      </div>
      <div class="rfoot">
        <div class="rbtns">
          <button class="btn back-button" id="rback" aria-label="Back to workout confirmation">Back</button>
          <button class="btn main" id="rnext">Next</button>
        </div>
      </div>
    </section>

    <script>
      import { DECKS } from '../workout/decks'
      import { drawRoutine, findRoutine, type RoutinePhase } from '../workout/decks/routines'
      import type { Deck, Suit } from '../workout/types'
      import { dealHand, uniqueCards, type Dealt } from '../workout/deal'
      import { buildPlan, cardCount, LAPS, LENGTHS, SETS, TYPES, type Plan, type Step, type WorkoutType } from '../workout/plan'

      const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T
      const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch] as string)

      const SUIT: Record<Suit, [string, string]> = { legs: ['♠', ''], push: ['♥', 'red'], pull: ['♦', 'red'], hinge: ['♣', ''], core: ['★', 'joker'] }
      const ROUTINE_LABELS: Record<RoutinePhase, string> = { warm: 'Warm-up', cool: 'Cool-down' }
      const KEY = 'workoutdecks.v1'

      /** A deck's art as CSS custom properties, for its box, card backs and card faces. */
      const art = (d: Pick<Deck, 'art'>) => {
        const a = d.art
        return esc(`--back:${a.back.background};--back-border:${a.back.border};--box:${a.box.color};--box-ink:${a.box.ink};--box-label:${a.box.label};--letter:${a.lettering.font};--letter-scale:${a.lettering.scale ?? 1};--face:${a.face.background};--face-text:${a.face.text};--face-muted:${a.face.muted};--face-line:${a.face.line};--face-accent:${a.face.accent};--red:${a.suits.red};--black:${a.suits.black};--star:${a.suits.star}`)
      }

      interface State {
        len: number
        type: WorkoutType
        /** Open decks. Their cards are shuffled together into one deck. */
        decks: Record<string, number>
        /** Cards on the table, in order. */
        hand: [string, string][] | null
        /** The rest of the deck, top card first. Dealing takes from the top; a swapped card goes to the bottom. */
        pile: [string, string][] | null
        routines?: Partial<Record<RoutinePhase, string>>
      }
      let st: State = { len: 30, type: 'circuit', decks: {}, hand: null, pile: null }
      try {
        const s = JSON.parse(localStorage.getItem(KEY) || 'null')
        if (s) {
          // Older saves opened the first deck automatically. Treat that old default as no selection.
          const chosen = s.manualDeckSelection || DECKS.slice(1).some((deck) => deck.id in (s.decks ?? {}))
          st = {
            len: s.len || st.len, type: s.type || st.type, decks: chosen ? (s.decks ?? {}) : {},
            hand: chosen ? (s.hand ?? null) : null, pile: chosen ? (s.pile ?? null) : null, routines: s.routines,
          }
        }
      } catch (e) {}
      const deckById = (id: string) => DECKS.find((d) => d.id === id)
      for (const id of Object.keys(st.decks)) if (!deckById(id)) delete st.decks[id]
      if (!LENGTHS[st.len]) st.len = 30
      if (!TYPES.some((t) => t.id === st.type)) st.type = 'circuit'
      let routines = {
        warm: findRoutine('warm', st.routines?.warm) ?? drawRoutine('warm'),
        cool: findRoutine('cool', st.routines?.cool) ?? drawRoutine('cool'),
      }
      const save = () => {
        try {
          st.routines = { warm: routines.warm.card.id, cool: routines.cool.card.id }
          localStorage.setItem(KEY, JSON.stringify({ ...st, manualDeckSelection: true }))
        } catch (e) {}
      }
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches

      const picked = () => DECKS.filter((d) => d.id in st.decks)
      const hasDecks = () => Object.keys(st.decks).length > 0
      /** Every card in the open decks is equally likely, so a deck's share follows its size. */
      const mix = () => picked().map((deck) => ({ deck, weight: deck.cards.length }))

      // ---- the deck: one real ordered deck of every card in the open decks ----
      // The hand is dealt off the top, the pile is what's left (top first), and the pile
      // on the table shows the backs of its actual top cards.
      const ids = (list: Dealt[]): [string, string][] => list.map((x) => [x.deck.id, x.card.id])
      const resolve = (list: [string, string][] | null): Dealt[] =>
        (list || []).flatMap(([d, c]) => {
          const deck = deckById(d)
          const card = deck?.cards.find((x) => x.id === c)
          return deck && card && d in st.decks ? [{ deck, card }] : []
        })
      const load = () => resolve(st.hand)
      const pileCards = () => resolve(st.pile)
      /**
       * Size the hand. Like a real deck, cards that leave the table always go to the bottom of
       * the pile, so the card on top never changes underneath you.
       *  - 'fit':     type or length changed. Cards on the table stay; extra cards come off the
       *               top; cards no longer needed go to the bottom.
       *  - 'cycle':   a new hand. Every card on the table goes to the bottom (rightmost first,
       *               the way they're tucked under) and the next cards come off the top.
       *  - 'shuffle': a deck was opened or closed. Every card in the open decks is shuffled
       *               together; each deck's share of the hand follows its size.
       */
      function setHand(mode: 'fit' | 'cycle' | 'shuffle') {
        const decks = mix()
        const total = uniqueCards(decks)
        if (!total) {
          st.hand = null
          st.pile = null
          save()
          return
        }
        const n = cardCount(st.type, st.len, total)
        let h = load(),
          p = pileCards()
        // A fresh deal brings a fresh warm-up and cool-down with it.
        if (mode !== 'fit') routines = { warm: drawRoutine('warm', routines.warm.card.id), cool: drawRoutine('cool', routines.cool.card.id) }
        if (mode === 'shuffle' || !h.length || h.length + p.length !== total) {
          // One shuffle of the whole deck: any card can land anywhere, so the hand's mix is random
          // and each deck's share follows its size on average.
          const order = dealHand(decks, total)
          h = order.slice(0, n)
          p = order.slice(n)
        } else if (mode === 'cycle') {
          p = p.concat(h.reverse())
          h = p.splice(0, n)
        } else if (h.length < n) h = h.concat(p.splice(0, n - h.length))
        else if (h.length > n) p = p.concat(h.splice(n).reverse())
        st.hand = ids(h)
        st.pile = ids(p)
        save()
      }
      function hand(): Dealt[] {
        if (hasDecks() && !load().length) setHand('fit')
        return load()
      }
      type TableCard =
        | { kind: 'work'; exercise: Dealt; number: number }
        | { kind: RoutinePhase; routine: ReturnType<typeof drawRoutine> }
      function tableHand(exercises = hand()): TableCard[] {
        return [
          { kind: 'warm', routine: routines.warm },
          ...exercises.map((exercise, i) => ({ kind: 'work' as const, exercise, number: i + 1 })),
          { kind: 'cool', routine: routines.cool },
        ]
      }
      /** Swap card `i`: it goes to the bottom of the pile and the top card takes its place. */
      function swap(i: number): Dealt {
        const h = load(),
          p = pileCards()
        p.push(h[i])
        h[i] = p.shift() as Dealt
        st.hand = ids(h)
        st.pile = ids(p)
        save()
        return h[i]
      }
      const plan = (): Plan =>
        buildPlan(
          st.type,
          st.len,
          hand().map((x) => x.card)
        )

      // ---- deck shelf and mix ----
      function renderDecks() {
        $('#decks').innerHTML =
          DECKS.map((d) => {
            const on = d.id in st.decks
            return `<button class="tuck" data-id="${d.id}" aria-pressed="${on}" aria-label="${esc(d.name)} deck" style="${art(d)}" title="${esc(d.blurb)} ${esc(d.gear)}.">
              <span class="box" aria-hidden="true">
                <span class="lid"></span>
                <span class="peek"><i></i><i></i></span>
                <span class="side"></span>
                <span class="bface"><span class="art"></span><span class="plate"><b>${esc(d.name)}</b></span><span class="suits">♠ ♥ ♦ ♣ ★</span></span>
                <span class="seal"></span>
              </span>
            </button>`
          }).join('')
        fitNames()
      }
      /** Shrink each deck name until it fits on its box label, whatever the deck's lettering. */
      function fitNames() {
        document.querySelectorAll<HTMLElement>('.plate b').forEach((b) => {
          b.style.fontSize = ''
          const room = (b.parentElement as HTMLElement).clientWidth * 0.9
          if (b.scrollWidth > room) b.style.fontSize = `${parseFloat(getComputedStyle(b).fontSize) * (room / b.scrollWidth)}px`
        })
      }
      document.fonts?.ready.then(fitNames)
      new ResizeObserver(fitNames).observe($('#decks'))
      /**
       * The pile shows the backs of its real top three cards, top card last (on top). `upcoming`
       * are cards about to be dealt off it, which sit on top until they leave.
       */
      function renderPile(upcoming: Dealt[] = []) {
        const top = upcoming.concat(pileCards()).slice(0, 3)
        $('#deck').classList.toggle('empty', !top.length)
        $('#deck').innerHTML =
          top
            .map((x, i) => `<span class="stock back l${i}" style="${art(x.deck)}"></span>`)
            .reverse()
            .join('')
      }
      $('#decks').addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.tuck')
        if (!b) return
        const id = b.dataset.id as string
        if (id in st.decks) delete st.decks[id]
        else st.decks[id] = 1
        b.setAttribute('aria-pressed', String(id in st.decks))
        setHand('shuffle')
        schedule()
      })

      // ---- cards ----
      function cardFront(deck: Pick<Deck, 'art'>, suit: Suit, label: number | string, content: string) {
        const [sym, cls] = SUIT[suit]
        const corner = (pos: string) => `<span class="corner ${pos}" aria-hidden="true"><b>${label}</b><i>${sym}</i></span>`
        return `<div class="face stock front ${cls}" style="${art(deck)}">${corner('tl')}${corner('br')}<span class="pip" aria-hidden="true">${sym}</span><div class="fbody">${content}</div></div>`
      }
      function face(x: Dealt, label: number | string) {
        const c = x.card
        return cardFront(x.deck, c.suit, label, `<h3>${esc(c.name)}</h3><p class="reps">${esc(c.reps)}</p><p class="cue">${esc(c.cue)}</p><p class="alt"><span><span class="vh">Easier: </span><i aria-hidden="true">−</i>${esc(c.easier)}</span><span><span class="vh">Harder: </span><i aria-hidden="true">+</i>${esc(c.harder)}</span></p>`)
      }
      /**
       * Shrink a card's text a little when its content won't fit the card. Sizes are relative to
       * the card's width, so a card fits the same way at every size.
       */
      function fit(root: ParentNode) {
        root.querySelectorAll<HTMLElement>('.front').forEach((f) => {
          let k = 1
          f.style.setProperty('--fit', '1')
          while (f.scrollHeight > f.clientHeight + 1 && k > 0.6) {
            k -= 0.04
            f.style.setProperty('--fit', String(k))
          }
        })
      }
      document.fonts?.ready.then(() => fit(document))

      let cards: HTMLElement[] = []
      const touch = matchMedia('(hover: none)')
      const phone = matchMedia('(max-width: 700px)')
      /** The help text on the Cards step, for each way of handling the cards. */
      const HINT = {
        touch: 'Swipe from warm-up to cool-down. Flick a card up to swap it. Tap the deck for new exercises.',
        mouse: 'Move your cursor across the hand to browse. Click the front card to swap it, or click the deck for new exercises.',
      }
      /** Match the help text to how the cards work right now; it changes with the layout. */
      const setHint = () => ($('#hint').textContent = phone.matches || touch.matches ? HINT.touch : HINT.mouse)
      phone.addEventListener('change', setHint)
      touch.addEventListener('change', setHint)
      /** Make one slot per card in the hand (the pile is always the first slot). */
      function slots(n: number) {
        const box = $('#hand')
        while (box.children.length - 1 < n) {
          const s = document.createElement('div')
          s.className = 'slot'
          s.innerHTML = '<div class="card pending" role="button" tabindex="0"></div>'
          const i = box.children.length - 1
          const c = s.firstElementChild as HTMLElement
          // Pointer clicks are handled by the hand gesture; assistive activation has no pointer.
          c.addEventListener('click', (e) => { if (e.detail === 0) redraw(i) })
          c.addEventListener('focus', () => {
            if (c.matches(':focus-visible') && i !== Math.round(pos)) fanTo(i)
          })
          c.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault()
              redraw(i)
            }
          })
          box.appendChild(s)
        }
        while (box.children.length - 1 > n) box.lastElementChild?.remove()
        cards = [...box.querySelectorAll<HTMLElement>('.card')]
      }
      function tableFace(x: TableCard) {
        if (x.kind === 'work') return face(x.exercise, x.number)
        return routineFace(x.routine, x.kind)
      }
      const routineDuration = (secs: number) => secs % 60 === 0 ? `${secs / 60} min` : `${secs} sec`
      function fill(i: number, x: TableCard) {
        const { deck } = x.kind === 'work' ? x.exercise : x.routine
        const description = x.kind === 'work'
          ? `Card ${x.number}, ${x.exercise.card.name}, ${x.exercise.card.reps}. ${x.exercise.card.cue}`
          : `${ROUTINE_LABELS[x.kind]}, ${x.routine.card.name}. ${x.routine.card.moves.map(([move, secs]) => `${move}, ${routineDuration(secs)}`).join('. ')}.`
        cards[i].innerHTML = tableFace(x) + `<div class="face stock back" style="${art(deck)}"></div>`
        cards[i].setAttribute('aria-label', `${description} Swap card.`)
        cards[i].dataset.kind = x.kind
        fit(cards[i])
      }

      // ---- schedule ----
      /** Time into the workout, e.g. 0:00, 4:00, 6:30. */
      const fmt = (secs: number) => `${Math.floor(secs / 60)}:${String(Math.round(secs % 60)).padStart(2, '0')}`
      function schedule() {
        const available = uniqueCards(mix())
        const how: Record<WorkoutType, (n: number) => string> = {
          circuit: (n) => `${LAPS} laps through ${n} cards`,
          sets: (n) => `${SETS} sets of each of ${n} cards`,
          variety: (n) => `${n} cards, each one once`,
        }
        document.querySelectorAll<HTMLElement>('[data-how]').forEach((el) => {
          const t = el.dataset.how as WorkoutType
          el.textContent = how[t](cardCount(t, st.len, available || undefined))
        })
        document.querySelectorAll<HTMLButtonElement>('#len button').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.v) === st.len)))
        document.querySelectorAll<HTMLButtonElement>('#type button').forEach((b) => b.setAttribute('aria-checked', String(b.dataset.v === st.type)))
        $<HTMLButtonElement>('#next').disabled = document.body.dataset.step === 'decks' && !available
        if (!available) {
          $('#times').replaceChildren()
          renderPile()
          return
        }
        const p = plan()
        const h = hand()
        const n = h.length
        let t = 0
        const rows: [number, string, string][] = []
        let workIndex = 0
        p.steps.forEach((s) => {
          if (s.kind === 'warm') rows.push([t, 'Warm-up', `${s.secs / 60} min`])
          if (s.kind === 'cool') rows.push([t, 'Cool-down', `${s.secs / 60} min`])
          if (s.kind === 'work') {
            const x = h[s.card]
            if (st.type === 'circuit' && s.card === 0) rows.push([t, `Lap ${Math.floor(workIndex / n) + 1}`, `All ${n} cards, one set each`])
            if (st.type === 'sets') rows.push([t, esc(x.card.name), `${s.sets} sets of ${esc(x.card.reps)}`])
            if (st.type === 'variety') rows.push([t, esc(x.card.name), esc(x.card.reps)])
            workIndex++
          }
          t += s.secs
        })
        rows.push([t, 'Done', ''])
        $('#times').innerHTML = rows.map(([at, h, p]) => `<li><span class="t">${fmt(at)}</span><div><h3>${h}</h3>${p ? `<p>${p}</p>` : ''}</div></li>`).join('')
        renderPile()
      }

      // ---- dealing: cards come off the top of the pile and go back onto it ----
      /**
       * From a card's resting place to the pile, worked out in the card's own frame (its slot may
       * be tilted and scaled in the fan): the offset, the scale that makes it the size of
       * the pile, and the turn that squares it up with the pile.
       */
      function toPile(el: HTMLElement) {
        const d = $('#deck').getBoundingClientRect()
        const slot = el.parentElement as HTMLElement
        const t = getComputedStyle(slot).transform
        const m = t && t !== 'none' ? new DOMMatrix(t) : new DOMMatrix()
        const r = slot.getBoundingClientRect()
        const sx = Math.hypot(m.a, m.b) || 1
        const v = new DOMMatrix([m.a, m.b, m.c, m.d, 0, 0]).inverse().transformPoint(new DOMPoint(d.left + d.width / 2 - (r.left + r.width / 2), d.top + d.height / 2 - (r.top + r.height / 2)))
        return { dx: v.x, dy: v.y, s0: d.width / (el.offsetWidth * sx), rot0: (-Math.atan2(m.b, m.a) * 180) / Math.PI }
      }
      /**
       * The deal: the top card is pushed off the pile at a slight angle, travels face down in a
       * low arc while turning toward where it lands, flips over just before it lands, and settles.
       * The card grows as it travels from the pile into the hand.
       */
      function dealKeys(el: HTMLElement): Keyframe[] {
        const { dx, dy, s0, rot0 } = toPile(el)
        const arc = Math.min(70, Math.abs(dx) * 0.12)
        const turn = Math.max(-9, Math.min(9, -dx / 60))
        const at = (p: number) => `translate(${dx * (1 - p)}px, ${dy * (1 - p) - Math.sin(Math.PI * p) * arc}px)`
